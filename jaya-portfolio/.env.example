# Google reCAPTCHA v3 secret from the same key pair as the site key in index.html
RECAPTCHA_SECRET_KEY=
# Comma-separated production hostnames, for example: nutriplex.vercel.app
RECAPTCHA_HOSTNAMES=nutriplex.vercel.app

# Vercel KV / Upstash REST credentials (used for the expiring, single-use OTP)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend credentials. RESEND_FROM_EMAIL must be a verified sender in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Existing Formspree endpoint; never expose a Formspree secret here.
FORMSPREE_ENDPOINT=https://formspree.io/f/xqevnloq

# Optional: enables carrier/line validation of supplied phone numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
